# Base URL of the FastAPI backend (backend/app/main.py).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Set this to the backend base URL to switch the reviewer UI from mock data to the
# live REST adapter (src/data/findings.api.ts). Leave unset to use the in-memory mock.
NEXT_PUBLIC_FINDINGS_API=http://127.0.0.1:8000
